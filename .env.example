GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL + pgvector connection (Docker Compose defaults shown)
POSTGRES_USER=querypilot
POSTGRES_PASSWORD=querypilot
POSTGRES_DB=querypilot
DATABASE_URL=postgresql+psycopg://querypilot:querypilot@localhost:5432/querypilot
# Required dedicated least-privilege read-only PostgreSQL URL for SQL execution
READ_DATABASE_URL=postgresql+psycopg://querypilot_reader:change-me-readonly-pass@localhost:5432/querypilot

# Redis cache, rate limiting, and ARQ background worker
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300
RATE_LIMIT_PER_MINUTE=30
ASYNC_UPLOAD_THRESHOLD_BYTES=524288
MAX_UPLOAD_SIZE_BYTES=2147483648
WORKER_JOB_TIMEOUT_SECONDS=1800

# JWT Authentication (replace with a strong random secret before running!)
JWT_SECRET_KEY=replace-with-a-strong-random-32-plus-char-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# LLM & Embedding models
PRIMARY_MODEL=gemini-3.6-flash
FALLBACK_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# Schema RAG & query execution guardrails
SCHEMA_RAG_TOP_K=5
SCHEMA_RAG_MIN_SIMILARITY=0.35
QUERY_TIMEOUT_MS=10000
MAX_QUERY_ROWS=1000

# Observability & optional OpenTelemetry tracing
ENABLE_TRACING=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=querypilot-backend

# API & Frontend networking
API_HOST=0.0.0.0
PORT=8000
BACKEND_URL=http://localhost:8000
